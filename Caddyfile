# Caddy 反代配置 — 自动 HTTPS (Let's Encrypt)
# 把 your-domain.com 替换为你的真实域名

# ================================================================
# 域名访问（自动 HTTPS）
# ================================================================
dwrider.top {
    reverse_proxy app:8000

    log {
        output file /var/log/caddy/access.log
    }

    request_body {
        max_size 50MB
    }
}

# ================================================================
# 公网 IP 访问（仅 HTTP，IP 无法签发 SSL 证书）
# 把 1.2.3.4 换成你阿里云 ECS 的公网 IP
# ================================================================
http://你的公网IP {
    reverse_proxy app:8000

    request_body {
        max_size 50MB
    }
}
