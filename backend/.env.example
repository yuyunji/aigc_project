# Claude API 配置
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5-20250915

# LLM 调用参数
LLM_MAX_RETRIES=2               # API 失败自动重试次数（含首次共 N+1 次）
LLM_RETRY_BASE_DELAY=2.0        # 重试指数退避基数（秒）
LLM_CALL_TIMEOUT=120            # 单次 LLM 调用超时（秒）
TASK_TOTAL_TIMEOUT=600          # 单个任务总超时（秒）

# 服务配置
HOST=127.0.0.1
PORT=8000

# 数据库
DATABASE_URL=sqlite:///./aigc_workbench.db

# 文本处理参数
MAX_CHUNK_SIZE=8000             # 分片大小（字符）
CHUNK_OVERLAP=200               # 分片重叠量（字符）
MAX_INPUT_CHARS=200000          # 最大输入字符数
MAX_CHUNKS_FOR_LLM=3            # 送入 LLM 的最大分片数
