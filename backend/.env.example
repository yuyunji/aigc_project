# ── LLM 后端选择 ──
# 可选 deepseek | anthropic（国内服务器用 deepseek，无需代理）
LLM_PROVIDER=deepseek

# DeepSeek API（OpenAI 兼容，国内直连）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude API（如需切回 Anthropic）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-20250915

# LLM 通用参数
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=2.0
LLM_CALL_TIMEOUT=120
TASK_TOTAL_TIMEOUT=600

# 服务配置
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./aigc_workbench.db

# 文本处理
MAX_CHUNK_SIZE=8000
CHUNK_OVERLAP=200
MAX_INPUT_CHARS=200000
MAX_CHUNKS_FOR_LLM=3

# DashScope — Wan-X-Turbo 分镜图片生成
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_IMAGE_SIZE=1280*720

# fal.ai — Seedance 1.5 Pro 图生视频
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FAL_VIDEO_DURATION=5
FAL_VIDEO_RESOLUTION=720p

# Volcengine TTS — 火山引擎角色配音（免费 1000 次/3 个月）
VOLC_ACCESS_KEY=xxxxxxxxxxxxxxxx
VOLC_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOLC_TTS_VOICE_TYPE=BV700_streaming

# FFmpeg 本地合成
FFMPEG_PATH=ffmpeg
MEDIA_DIR=media
