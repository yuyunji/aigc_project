# ── LLM 后端选择 ──
# 可选 deepseek | anthropic（国内服务器用 deepseek，无需代理）
LLM_PROVIDER=deepseek

# DeepSeek API（OpenAI 兼容，国内直连）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude API（如需切回 Anthropic）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-20250915

# LLM 通用参数
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY=2.0
LLM_CALL_TIMEOUT=600
TASK_TOTAL_TIMEOUT=1800

# 服务配置
HOST=127.0.0.1
PORT=8000
DATABASE_URL=mysql+pymysql://aigc:aigc_pass@127.0.0.1:3306/aigc_workbench?charset=utf8mb4

# 文本处理
MAX_CHUNK_SIZE=8000
CHUNK_OVERLAP=200
MAX_INPUT_CHARS=200000
MAX_CHUNKS_FOR_LLM=3

# MiniMax-H3 — 文生视频（含内置音频同步）
MINIMAX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_VIDEO_DURATION=6
MINIMAX_VIDEO_RATIO=16:9
MINIMAX_VIDEO_RESOLUTION=2K

# ── 图片/视频 Provider 选择 ──
IMAGE_PROVIDER=minimax                 # minimax | gpt-image-2
VIDEO_PROVIDER=minimax-h3              # minimax-h3 | comfyui

# ── ComfyUI 本地 MiniMax H3 视频生成 ──
COMFYUI_URL=http://127.0.0.1:8198
COMFYUI_POLL_INTERVAL=5
COMFYUI_POLL_MAX_RETRIES=360

# ── 智谱 CogVideoX 文生视频 ──
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VIDEO_MODEL=cogvideox
ZHIPU_VIDEO_DURATION=6
ZHIPU_VIDEO_RESOLUTION=1080p
ZHIPU_POLL_INTERVAL=10
ZHIPU_POLL_MAX_RETRIES=60

# ── GPT-Image-2 (OpenAI / 智创聚合API) ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1792x1024
OPENAI_IMAGE_QUALITY=high

# ── Seedance 1.5 Pro (fal.ai 图生视频) ──
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/seedance-1.5-pro
FAL_VIDEO_DURATION=5
FAL_VIDEO_RESOLUTION=1080p
FAL_POLL_INTERVAL=10
FAL_POLL_MAX_RETRIES=60

# FFmpeg 本地拼接
FFMPEG_PATH=ffmpeg
MEDIA_DIR=media

# ── 阿里云 OSS（私有 Bucket + 签名 URL）──
OSS_ACCESS_KEY_ID=xxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxx
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_URL_EXPIRE=3600
